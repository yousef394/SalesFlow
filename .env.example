# Copy this file to .env and replace the placeholder values.
# Never commit .env or expose real credentials.

# --- Application databases (PostgreSQL) ---
# Used when running Python directly on your machine.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=change-me
SOURCE_DB_NAME=sales_db
DWH_DB_NAME=sales_dwh

# Used by Docker containers to reach PostgreSQL on your host.
# For Docker Desktop on Windows/macOS, use host.docker.internal.
DOCKER_DB_HOST=host.docker.internal

# --- Airflow ---
# Linux/WSL: use the output of `id -u`.
# Windows/macOS Docker Desktop: use 50000.
AIRFLOW_UID=50000

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Airflow web UI credentials (created by airflow-init).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Airflow internal metadata database password.
# Leave unset to use the Compose default.
# Changing it after initialization requires updating the database too.
# AIRFLOW_DB_PASSWORD=airflow

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Spark ---
# Spark driver memory allocation.
SPARK_DRIVER_MEMORY=2g
