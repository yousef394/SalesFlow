# Streamlit dashboard: its own image, independent from Airflow.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg \
    PYTHONPATH=/app

RUN useradd --create-home --uid 1000 dashboard
WORKDIR /app
COPY requirements-dashboard.txt /tmp/requirements-dashboard.txt
# Long timeout, many retries and a build cache: a slow or interrupted download (pyarrow is ~50 MB)
# resumes from the cache on the next `docker compose build` instead of starting over.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --default-timeout=120 --retries 10 -r /tmp/requirements-dashboard.txt

USER dashboard
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=4).status == 200 else 1)"
# src/ is mounted at /app/src by docker-compose
CMD ["streamlit", "run", "src/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]